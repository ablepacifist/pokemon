# =============================================================================
# pokemonServer standalone environment template.
#
# LAYERING (lowest -> highest priority):
#   1. this module's own `.env` (git-ignored - copy this file to `.env` to
#      run pokemonServer standalone) and the ${KEY:default} fallbacks baked
#      into application.properties
#   2. the monorepo root `.env` (found via ../../../.env from this directory,
#      or the absolute path in $MASTER_ENV_FILE if set) - OVERRIDES this
#      module's own values, same key names
#   3. real process environment variables (highest)
# A module cloned/run by itself still starts fine on layer 1 alone.
#
# Same key names as the root registry (full-back-end-server/.env.example).
# Format: KEY=value, one per line, no quotes, no inline comments, forward
# slashes in paths (Spring reads this as a .properties file).
# =============================================================================

SERVER_ADDRESS=0.0.0.0
POKEMON_PORT=8090

# HSQLDB - jdbc:hsqldb:hsql://localhost:9002/mydb is the live, shared database.
DATABASE_URL=jdbc:hsqldb:hsql://localhost:9002/mydb

# Sprite folders. Relative defaults assume this module sits at
# pokemon/pokemon/pokemonServer inside a full monorepo checkout and is run
# from that directory; set absolute paths if running from elsewhere.
POKEMON_SPRITES_PATH=../../pogo_assets/Images/Pokemon
POKEMON_ITEM_SPRITES_PATH=../../pogo_assets/Images/Items
POKEMON_ITEM_SPRITES_FALLBACK=../../moreAssets/pokesprite/items

# CORS - exact origins and wildcard patterns (comma-separated, no spaces).
# LAN_HOST / PLAYIT_HOST below are additionally appended as
# http://<host>:* patterns automatically when set.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,https://alex-dyakin.com
CORS_ALLOWED_ORIGIN_PATTERNS=https://*.alex-dyakin.com,http://*.playit.pub:*,http://*.with.playit.plus:*,http://*.gl.at.ply.gg:*,http://localhost:*,capacitor://localhost,https://localhost
LAN_HOST=192.168.1.4
PLAYIT_HOST=209.25.140.16

# LexiconServer internal port, used for SSO token validation
# (composed as http://127.0.0.1:<port>).
LEXICON_PORT=36568
